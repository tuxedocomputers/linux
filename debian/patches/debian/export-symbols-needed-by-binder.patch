+++ b/ipc/msgutil.c
@@ -35,6 +35,7 @@ struct msg_msgseg {
 	struct msg_msgseg *next;
 	/* the next part of the message follows immediately */
 };
+EXPORT_SYMBOL_GPL(init_ipc_ns);
 
